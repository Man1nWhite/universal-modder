.venv/
__pycache__/
*.pyc
uv.lock
.env
# intermediate build outputs (extracted VPKs, textures, previews, unpacked trees)
build/*
!build/pd2-las/
build/pd2-las/*
!build/pd2-las/Miranda_LAS.zip
!build/pd2-las/Miranda_LAS.zip.sha256
# generated distributions (built packs are outputs, not sources)
dist/*
# ...except the published LAS and Joy head-replacement packs: they are tracked
# so the repository always carries the exact bytes of the built deliverables.
!dist/lawson_las.zip
!dist/lawson_las.zip.sha256
!dist/Miranda_LAS.zip
!dist/Miranda_LAS.zip.sha256
!dist/Miranda_L4D2_over_Joy.zip
!dist/Miranda_L4D2_over_Joy.zip.sha256
!dist/Miranda_Romance_over_Joy.zip
!dist/Miranda_Romance_over_Joy.zip.sha256
!dist/Miranda_L4D2_over_Clover.zip
!dist/Miranda_L4D2_over_Clover.zip.sha256
!dist/Miranda_Romance_over_Clover.zip
!dist/Miranda_Romance_over_Clover.zip.sha256
!dist/Miranda_L4D2_over_Bonnie.zip
!dist/Miranda_L4D2_over_Bonnie.zip.sha256
!dist/Miranda_Romance_over_Bonnie.zip
!dist/Miranda_Romance_over_Bonnie.zip.sha256
!dist/Miranda_L4D2_over_Sydney.zip
!dist/Miranda_L4D2_over_Sydney.zip.sha256
!dist/Miranda_Romance_over_Sydney.zip
!dist/Miranda_Romance_over_Sydney.zip.sha256
*.egg-info/
# captures and scratch
*.mkv
*.audio.raw
/scratch/
.pytest_cache/
# the parent repo ignores bin/ (build output); the CLI launcher lives here
!bin/
preview_tmp/
