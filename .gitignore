.venv/
__pycache__/
*.pyc
uv.lock
.env
.env.*
*.env
*.env.*
# intermediate build outputs (extracted VPKs, textures, previews, unpacked trees)
build/*
# Shipped ZIPs and their checksum sidecars: published as release assets, not committed.
# `assets.json` names their bytes; `make -sC tools/pd2-las fetch` brings them back.
# docs/pd2-las/RELEASE_ASSETS.md has the runbook.
dist/
*.egg-info/
# captures and scratch
*.mkv
*.audio.raw
/scratch/
.pytest_cache/
# the parent repo ignores bin/ (build output); the CLI launcher lives here
!bin/
preview_tmp/
# Build inputs, also release assets. The provenance table stays: a clone has to read it.
references/*
!references/README.md

.hypothesis/
